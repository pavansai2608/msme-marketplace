{
  "name": "msme-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test:ci": "cross-env NODE_ENV=test JEST_JUNIT_OUTPUT_DIR=test-results JEST_JUNIT_OUTPUT_NAME=jest-junit.xml jest --runInBand --ci --reporters=default --reporters=jest-junit --coverage",
    "seed:e2e": "node scripts/seedE2E.js",
    "knip": "knip"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.1",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "jest-junit": "^17.0.0",
    "knip": "^6.35.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
