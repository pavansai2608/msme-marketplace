# Mongo connection. Use the SAME value as msme-backend/.env - the recommender
# reads the existing database, it never creates its own.
MONGO_URL=mongodb+srv://user:password@cluster.example.mongodb.net/msme-marketplace

# Hybrid blend weights. Should sum to 1.0, but they are normalised anyway.
CONTENT_WEIGHT=0.6
COLLAB_WEIGHT=0.4

# Service port
PORT=8000
